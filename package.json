{
  "name": "semi-design-plus",
  "version": "0.1.0",
  "files": [
    "dist",
    "src/styles"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts"
    },
    "./styles": "./src/styles/index.css",
    "./styles/*": "./src/styles/*"
  },
  "scripts": {
    "build": "rslib build",
    "test": "rstest run",
    "test:watch": "rstest",
    "test-storybook": "test-storybook",
    "test-storybook:ci": "storybook build -o storybook-static && http-server storybook-static --silent --port 6006 & wait-on http://127.0.0.1:6006 && test-storybook --url http://127.0.0.1:6006",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit",
    "lint": "rslint .",
    "lint:fix": "rslint --fix .",
    "format": "oxfmt -c oxfmt.config.ts .",
    "format:check": "oxfmt -c oxfmt.config.ts --check ."
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@hookform/resolvers": "^6.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.1",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.514.0",
    "next-themes": "^0.4.6",
    "react-day-picker": "^9.8.0",
    "react-hook-form": "^7.91.0",
    "react-resizable-panels": "^2.1.7",
    "recharts": "^3.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.3.0"
  },
  "devDependencies": {
    "@rslint/core": "^0.10.0",
    "@rsbuild/core": "^2.3.0",
    "@rsbuild/plugin-react": "^2.1.1",
    "@rslib/core": "^1.0.5",
    "@rstest/core": "^0.12.5",
    "@rstest/browser": "^0.12.5",
    "@storybook/addon-a11y": "^9.0.0",
    "@storybook/addon-docs": "^9.1.21",
    "@storybook/addon-themes": "^9.0.0",
    "@storybook/react-vite": "^9.0.0",
    "@storybook/test-runner": "^0.26.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "happy-dom": "^21.0.4",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "playwright": "^1.49.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "storybook": "^9.1.21",
    "storybook-addon-rslib": "^3.6.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "10.15.1"
    }
  }
}
